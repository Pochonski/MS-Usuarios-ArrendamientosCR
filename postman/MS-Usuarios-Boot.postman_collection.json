      "name": "06. OpenAPI / Swagger",
      "item": [
        {
          "name": "06.1 OpenAPI 3 JSON spec",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v3/api-docs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            },
            "description": "OpenAPI 3 spec generada automáticamente por springdoc-openapi. Endpoint público."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "// Detección de proxy SWA: el SWA proxia /api/* pero no /v3/* ni /swagger-ui*, devuelve index.html",
                  "const ct = pm.response.headers.get('Content-Type') || '';",
                  "const isSwaProxy = !ct.includes('json') && pm.response.text().includes('<!DOCTYPE html>');",
                  "if (isSwaProxy) {",
                  "  pm.test('INFO: /v3/api-docs no es accesible vía SWA proxy (solo /api/* se proxia). Para validar el spec, usar el environment azure.postman_environment.json con el backend deslinkeado.', () => true);",
                  "} else {",
                  "  pm.test('Content-Type es JSON', () => pm.expect(ct).to.include('json'));",
                  "  const body = pm.response.json();",
                  "  pm.test('Spec tiene OpenAPI 3', () => pm.expect(body).to.have.property('openapi'));",
                  "  pm.test('Spec tiene paths', () => pm.expect(body).to.have.property('paths'));",
                  "}"
                ]
              }
            }
          ]
        },
