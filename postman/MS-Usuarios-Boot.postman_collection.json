    {
      "name": "05. Usuarios - CRUD (con token activo)",
      "item": [
        {
          "name": "05.1 GET /api/usuarios (listar paginado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/usuarios?page=1&limit=10",
