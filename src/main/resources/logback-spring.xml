<?xml version="1.0" encoding="UTF-8"?>
<!--
  W3.6: logback-spring.xml con JSON encoder en prod.

  Perfiles:
    - prod (default): JSON lines via LogstashEncoder (parseable por AI agent,
      Elastic, Splunk, Datadog, etc.). 1 línea = 1 evento JSON.
    - dev / test: texto plano con timestamp + thread + level + logger + msg.

  La dep net.logstash.logback:logstash-logback-encoder:8.0 ya está en pom.xml.
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="ms-usuarios-boot"/>
    <springProperty scope="context" name="activeProfile" source="spring.profiles.active" defaultValue="dev"/>

    <!-- ========== APPENDER: prod JSON ========== -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <customFields>{"service":"${appName}","profile":"${activeProfile}"}</customFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>message</message>
                <thread>thread</thread>
                <logger>logger</logger>
                <level>level</level>
            </fieldNames>
        </encoder>
    </appender>

    <!-- ========== APPENDER: dev/test texto ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========== Perfil prod: JSON ========== -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
        <logger name="com.arrendamientos.usuarios" level="INFO"/>
        <logger name="org.flywaydb" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
    </springProfile>

    <!-- ========== Perfiles no-prod: texto ========== -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.arrendamientos.usuarios" level="INFO"/>
        <logger name="org.flywaydb" level="INFO"/>
        <logger name="org.springframework.security" level="INFO"/>
    </springProfile>

</configuration>
